# Copy this file to .env and fill in the values. Never commit .env.

# Port for the API server (the frontend dev server proxies /api here)
PORT=3001

# Google Gemini API key (https://aistudio.google.com/apikey) - required for the
# chatbot, voice assistant and crop image analysis.
GEMINI_API_KEY=
# Optional: Gemini model to use (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# JWT_EXPIRES_IN=7d

# Optional: SQLite database file (default ./database/krishi_sakhi.db)
# DB_PATH=./database/krishi_sakhi.db

# Optional: comma-separated list of browser origins allowed to call the API
# CORS_ORIGIN=http://localhost:3000

# Optional: timeout for the ISRIC SoilGrids soil API in ms (default 12000)
# SOILGRIDS_TIMEOUT_MS=12000
